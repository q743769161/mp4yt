---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PlatformHero from '../components/PlatformHero.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

// YT-specific FAQs for this landing page
const ytFaqs = [
  {
    q: "What is a YouTube video downloader?",
    a: "A YouTube video downloader is an online tool that saves videos from YouTube to your device. mp4yt lets you download any YouTube video as an MP4 file in resolutions up to 4K, or convert it to MP3 for audio-only. Just paste the video URL, click Extract, and download — no app or account needed."
  },
  {
    q: "How do I download YouTube videos with mp4yt?",
    a: "It takes four simple steps: 1) Copy the YouTube video URL from your browser or app. 2) Go to mp4yt.com and paste the URL into the extraction bar. 3) Click 'Extract' and wait a few seconds. 4) Select your preferred quality (up to 4K) or choose MP3, then click Download."
  },
  {
    q: "Is mp4yt free to use?",
    a: "Yes, mp4yt is 100% free. There are no subscriptions, premium tiers, hidden costs, or account requirements. We believe everyone should have access to a fast, reliable video downloader without paywalls."
  },
  {
    q: "Does this work on iPhone and Android?",
    a: "Yes. Since mp4yt is entirely web-based, it works on any device with a modern browser — iPhone (Safari), Android (Chrome), iPad, Windows, Mac, and Linux. On iOS, use 'Save to Files' after downloading. On Android, files save directly to your Downloads folder."
  },
  {
    q: "Can I convert YouTube videos to MP3?",
    a: "Absolutely. After pasting your YouTube link and clicking Extract, select the audio-only option to download the soundtrack as a high-quality MP3 file. Perfect for music, podcasts, audiobooks, and lectures."
  },
  {
    q: "Is it safe to download YouTube videos online?",
    a: "mp4yt is completely safe — it runs in your browser with no software to install, no malware risk, and no personal data collection. We never store downloaded files on our servers. Regarding legality, downloading for personal, offline use of non-copyrighted content is generally permissible. Always respect content creators' rights."
  },
  {
    q: "What video quality options are available?",
    a: "mp4yt supports every quality option available on YouTube: 360p, 480p, 720p HD, 1080p Full HD, 1440p 2K, and 2160p 4K Ultra HD. The exact options depend on what the original uploader provided. We deliver the direct CDN stream for maximum quality."
  },
  {
    q: "Do I need to install any software?",
    a: "No. mp4yt works entirely in your web browser — Chrome, Safari, Firefox, Edge, or any modern browser. There's no desktop app, browser extension, or mobile app to download. This eliminates risks from third-party software and keeps your device clean."
  }
];

// Generate FAQ JSON-LD Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": ytFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

// HowTo Schema for step-by-step
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Download YT Videos with mp4yt",
  "description": "Step-by-step guide to download YT videos using the mp4yt yt video downloader online tool.",
  "totalTime": "PT1M",
  "tool": {
    "@type": "HowToTool",
    "name": "mp4yt YT Downloader"
  },
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Copy the YouTube video URL",
      "text": "Open YouTube in your browser or app, find the video you want to download, and copy the URL from the address bar or share button."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Paste the URL into mp4yt",
      "text": "Go to mp4yt.com/yt-downloader and paste the copied YouTube URL into the extraction bar."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Click Extract",
      "text": "Click the 'Extract' button and wait a few seconds for mp4yt to fetch the direct download links."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Download your video or audio",
      "text": "Choose your preferred quality (up to 4K) or select MP3 for audio-only, then click the download button to save the file."
    }
  ]
};

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "mp4yt",
      "item": "https://mp4yt.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "YT Downloader",
      "item": "https://mp4yt.com/yt-downloader"
    }
  ]
};
---

<Layout
  title="YouTube Video Downloader — Free MP4 & MP3 Download | mp4yt"
  description="Download YouTube videos for free in 4K MP4 or MP3. Works on iPhone, Android, and PC. No app installation needed — paste a link and save."
  canonicalUrl="https://mp4yt.com/yt-downloader/"
>
  <Navbar />
  <main id="main-content">
    <!-- JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <PlatformHero
      platform="YouTube"
      emoji="▶️"
      accentColor="#FF0000"
      tagline="YouTube Downloader"
      description="Just Paste and Play."
      placeholder="https://www.youtube.com/watch?v=..."
      features={[
        "Download YT videos in 4K",
        "YT to MP3 converter",
        "No app needed",
        "100% free",
        "Works on all devices",
      ]}
    />

    <!-- Long-form SEO Content -->
    <section class="seo-section page-container">
      <div class="seo-long-form">
        <article class="seo-article">
          <h2 class="display-md">What Is a YouTube Video Downloader?</h2>
          <p class="body-md">
            A YouTube video downloader is an online tool that saves videos from YouTube directly to your device for offline viewing. Instead of streaming and using mobile data every time, you can save videos permanently. mp4yt makes this process simple — it works in any web browser, requires no software installation, and is completely free. Whether you want to save tutorials, music videos, documentaries, or lectures, just paste the URL and download.
          </p>
        </article>

        <article class="seo-article">
          <h2 class="display-md">How to Download YouTube Videos</h2>
          <p class="body-md">
            Downloading YouTube videos with mp4yt is straightforward:
          </p>
          <ol class="seo-steps">
            <li><strong>Copy the YouTube URL</strong> — Open YouTube in your browser or app, find the video you want, and copy the URL from the address bar or share button.</li>
            <li><strong>Paste into mp4yt</strong> — Come to this page and paste the YouTube video URL into the extraction bar above.</li>
            <li><strong>Click Extract</strong> — Hit the "Extract" button and wait a few seconds while mp4yt fetches the direct download links.</li>
            <li><strong>Download</strong> — Choose your preferred quality (360p to 4K) or select MP3 for audio-only, then click download.</li>
          </ol>
          <p class="body-md">
            The entire process takes less than 30 seconds. No sign-up, no app installation, no limits.
          </p>
        </article>

        <article class="seo-article">
          <h2 class="display-md">YouTube to MP4 Converter</h2>
          <p class="body-md">
            mp4yt delivers direct MP4 streams from YouTube's CDN, meaning you get the highest possible quality without any re-encoding or compression. Every resolution available on YouTube is supported — from 360p standard definition up to 2160p 4K Ultra HD. The downloaded MP4 files play on every device and media player, including VLC, Windows Media Player, QuickTime, and all mobile video apps.
          </p>
        </article>

        <article class="seo-article">
          <h2 class="display-md">YouTube to MP3 — Audio Extraction</h2>
          <p class="body-md">
            Need just the audio? mp4yt can extract high-quality audio from any YouTube video and save it as an MP3 file. This is perfect for downloading music, podcasts, audiobooks, ASMR, and lectures. The original audio bitrate is preserved for crystal-clear playback. No separate converter app needed — video and audio downloads happen from the same interface.
          </p>
        </article>

        <article class="seo-article">
          <h2 class="display-md">Download YouTube Videos on iPhone & Android</h2>
          <p class="body-md">
            Looking for a way to download YouTube videos on your phone? mp4yt is fully optimized for mobile devices. Unlike traditional downloader apps that require installation and often contain ads or malware, mp4yt runs entirely in your browser. On <strong>iPhone</strong>, after extracting the video, tap the download link and select "Save to Files" to store it locally. On <strong>Android</strong>, downloads start automatically. No app needed, no storage wasted.
          </p>
        </article>

        <article class="seo-article">
          <h2 class="display-md">Why Choose mp4yt?</h2>
          <p class="body-md">
            mp4yt was built with one goal: give users the fastest, simplest, and most reliable way to download YouTube videos. No countdown timers, no CAPTCHAs, no speed limits, and no premium paywalls. Our backend uses advanced stream extraction to fetch direct CDN links in milliseconds. We never store your files on our servers, so your privacy is always protected. It's a video downloader that respects your time and your data.
          </p>
        </article>
      </div>
    </section>

    <!-- Dedicated YT FAQ -->
    <section id="faq" class="faq-band" aria-labelledby="yt-faq-headline">
      <div class="page-container faq-inner">
        <div class="faq-header">
          <span class="eyebrow">YT Downloader FAQ</span>
          <h2 id="yt-faq-headline" class="display-lg faq-title">
            Common questions about our YT downloader.
          </h2>
        </div>

        <div class="faq-list">
          {ytFaqs.map((faq) => (
            <details class="faq-item">
              <summary>
                <span class="body-md-strong">{faq.q}</span>
                <svg class="faq-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </summary>
              <div class="faq-body">
                <p class="body-md" style="color: var(--color-body); margin: 0;">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Internal linking section -->
    <section class="internal-links-section page-container">
      <div class="internal-links-grid">
        <div class="internal-link-card card">
          <h3 class="display-xs">Download From Other Platforms</h3>
          <p class="body-sm" style="color: var(--color-body);">mp4yt supports 1000+ video platforms beyond YouTube:</p>
          <ul class="internal-links-list">
            <li><a href="/instagram/">Instagram Video & Reels Downloader</a></li>
            <li><a href="/tiktok/">TikTok Video Downloader</a></li>
            <li><a href="/twitter/">Twitter/X Video Downloader</a></li>
            <li><a href="/facebook/">Facebook Video Downloader</a></li>
            <li><a href="/reddit/">Reddit Video Downloader</a></li>
            <li><a href="/vimeo/">Vimeo Video Downloader</a></li>
            <li><a href="/twitch/">Twitch Clip Downloader</a></li>
            <li><a href="/soundcloud/">SoundCloud Downloader</a></li>
            <li><a href="/">Browse All Platforms →</a></li>
          </ul>
        </div>
        <div class="internal-link-card card">
          <h3 class="display-xs">Resources</h3>
          <p class="body-sm" style="color: var(--color-body);">Learn more about mp4yt and how it works:</p>
          <ul class="internal-links-list">
            <li><a href="/about-us/">About mp4yt</a></li>
            <li><a href="/contact-us/">Contact Us</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms-and-conditions/">Terms & Conditions</a></li>
            <li><a href="/dmca/">DMCA Policy</a></li>
            <li><a href="/">Homepage</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Long-form SEO content */
  .seo-section {
    padding: var(--sp-4xl) var(--sp-lg);
    border-top: var(--border);
  }

  .seo-long-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3xl);
    max-width: 800px;
  }

  .seo-article {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .seo-article h2 {
    margin: 0;
    color: var(--color-ink);
  }

  .seo-article p {
    margin: 0;
    color: var(--color-body);
    line-height: 1.8;
  }

  .seo-steps {
    margin: 0;
    padding-left: var(--sp-lg);
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    color: var(--color-body);
    font-size: 15px;
    line-height: 1.8;
  }

  /* FAQ styles — brutalist */
  .faq-band {
    background-color: var(--color-canvas);
    padding: var(--sp-5xl) var(--sp-lg);
    border-top: var(--border);
  }

  .faq-inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: var(--sp-3xl);
    align-items: start;
  }

  .faq-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    position: sticky;
    top: 80px;
  }

  .faq-title {
    margin: 0;
    max-width: 300px;
  }

  .faq-list {
    border-top: var(--border);
  }

  details.faq-item {
    border-bottom: var(--border);
  }

  details.faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    padding: var(--sp-lg) var(--sp-sm);
    font-family: var(--font-headline);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: all 0.1s ease;
    user-select: none;
  }

  details.faq-item summary::-webkit-details-marker { display: none; }
  details.faq-item summary::marker { display: none; }
  details.faq-item summary span {
    flex: 1;
    text-align: left;
  }
  details.faq-item summary:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    padding-left: var(--sp-md);
    padding-right: var(--sp-md);
  }

  details.faq-item .faq-body {
    overflow: hidden;
    height: 0;
    transition: height 0.3s ease;
  }

  details.faq-item[open] .faq-body {
    height: auto;
    padding: 0 var(--sp-sm) var(--sp-lg);
  }

  .faq-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.3s ease, color 0.15s ease;
  }

  details.faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-ink);
  }

  details.faq-item summary:hover .faq-icon {
    color: var(--color-on-primary);
  }

  /* Internal linking section */
  .internal-links-section {
    padding: var(--sp-4xl) var(--sp-lg);
    border-top: var(--border);
  }

  .internal-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: var(--border);
    background-color: var(--color-primary);
    gap: 2px;
  }

  .internal-link-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
    padding: var(--sp-xl);
    background-color: var(--color-canvas);
    border: none;
  }

  .internal-link-card h3 {
    margin: 0;
    color: var(--color-ink);
  }

  .internal-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
  }

  .internal-links-list a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-body);
    text-decoration: none;
    transition: all 0.1s ease;
  }

  .internal-links-list a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .internal-links-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
  }

  .internal-links-tags li a {
    display: inline-block;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink);
    background-color: var(--color-canvas);
    border: var(--border);
    text-decoration: none;
    transition: all 0.1s ease;
  }

  .internal-links-tags li a:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  @media (max-width: 992px) {
    .internal-links-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 1024px) {
    .faq-inner { grid-template-columns: 1fr; gap: var(--sp-xl); }
    .faq-header { position: static; }
    .faq-title { max-width: none; }
    .faq-band { padding: var(--sp-4xl) var(--sp-md); }
    .seo-section { padding: var(--sp-3xl) var(--sp-md); }
    .internal-links-section { padding: var(--sp-3xl) var(--sp-md); }
  }

  @media (max-width: 480px) {
    .faq-band { padding: var(--sp-3xl) var(--sp-sm); }
    .seo-section { padding: var(--sp-2xl) var(--sp-sm); }
    .internal-links-section { padding: var(--sp-2xl) var(--sp-sm); }
    details.faq-item summary {
      padding: var(--sp-md) var(--sp-xs);
      font-size: 14px;
      min-height: 44px;
    }
    details.faq-item .faq-body p {
      font-size: 14px;
      line-height: 22px;
    }
    .internal-link-card { padding: var(--sp-md); }
  }
</style>

<script>
  const items = document.querySelectorAll('details.faq-item');

  items.forEach((detail) => {
    const summary = detail.querySelector('summary');
    const body = detail.querySelector('.faq-body') as HTMLElement | null;

    if (!summary || !body) return;

    summary.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = detail.hasAttribute('open');

      if (!isOpen) {
        detail.setAttribute('open', '');
        const h = body.scrollHeight;
        body.style.height = '0px';
        requestAnimationFrame(() => {
          body.style.height = h + 'px';
          body.addEventListener('transitionend', () => {
            body.style.height = 'auto';
          }, { once: true });
        });
      } else {
        body.style.height = body.scrollHeight + 'px';
        requestAnimationFrame(() => {
          body.style.height = '0px';
          body.addEventListener('transitionend', () => {
            detail.removeAttribute('open');
          }, { once: true });
        });
      }
    });
  });
</script>
