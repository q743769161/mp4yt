      ['Native Ecosystem', 'macOS, iOS, Final Cut Pro', 'Everything (Windows, Android, Web, Smart TVs)'],
      ['Professional Editing', 'Excellent support for Apple ProRes', 'Standard for web delivery (H.264/H.265)'],
