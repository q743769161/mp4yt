---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogTitle?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  keywords?: string;
  breadcrumbItems?: BreadcrumbItem[];
}

const SITE_URL = 'https://mp4yt.com';

const {
  title = 'mp4yt — Free YouTube Video Downloader | MP4 & MP3',
  description = 'Download YouTube videos as MP4 or MP3 for free. mp4yt also supports Instagram, TikTok, Twitter/X and 1000+ platforms. No app needed — works in your browser.',
  ogImage: ogImageProp = '/og-default.png',
  ogTitle = title,
  canonicalUrl = `${SITE_URL}/`,
  noindex = false,
  keywords,
  breadcrumbItems,
} = Astro.props;

// Build breadcrumb schema from items prop, falling back to homepage-only
const breadcrumbListItems = breadcrumbItems && breadcrumbItems.length > 0
  ? breadcrumbItems.map((item, i) => ({
      "@type": "ListItem" as const,
      "position": i + 1,
      "name": item.name,
      "item": item.href.startsWith('http') ? item.href : `${SITE_URL}${item.href}`
    }))
  : [
      {
        "@type": "ListItem" as const,
        "position": 1,
        "name": "mp4yt — YouTube Video Downloader",
        "item": "https://mp4yt.com"
      }
    ];

// Resolve OG image to an absolute URL for social crawlers
const ogImage = ogImageProp.startsWith('http') ? ogImageProp : `${SITE_URL}${ogImageProp}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-adsense-account" content="ca-pub-7623715056779529">

    <!-- Preconnect to external origins for faster LCP -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LNH5RT5R2G" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Grant analytics & ad consent by default
      gtag('consent', 'default', {
        'ad_storage': 'granted',
        'ad_user_data': 'granted',
        'ad_personalization': 'granted',
        'analytics_storage': 'granted'
      });

      gtag('js', new Date());
      gtag('config', 'G-LNH5RT5R2G');

      // Astro client-side navigation tracking
      document.addEventListener('astro:page-load', () => {
        gtag('config', 'G-LNH5RT5R2G', {
          page_path: window.location.pathname,
        });
      });
    </script>

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Mp4yt" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="mp4yt" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mp4yt" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme: FOUC prevention — must run before paint -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') {
          document.documentElement.setAttribute('data-theme', t);
        }
      })();
    </script>

    <!-- Robots & Indexing -->
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f9f9f9" media="(prefers-color-scheme: light)" />

    <!-- Structured Data (JSON-LD) — WebApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "mp4yt",
      "alternateName": "YouTube Video Downloader",
      "url": "https://mp4yt.com",
      "description": description,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web, Android, iOS, Windows, macOS, Linux",
      "browserRequirements": "Requires a modern web browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Download YouTube videos in up to 4K resolution",
        "Convert YouTube videos to MP3 audio",
        "Save videos as MP4 files",
        "No app installation required",
        "Works on iPhone, Android, PC, and Mac",
        "Supports 1000+ video platforms"
      ]
    })} />

    <!-- Structured Data (JSON-LD) — Organization (E-E-A-T) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "mp4yt",
      "url": "https://mp4yt.com",
      "logo": "https://mp4yt.com/logo.png",
      "description": "Free browser-based video downloader supporting YouTube, Instagram, TikTok, and 1000+ platforms.",
      "sameAs": [
        "https://github.com/nitin2122/mp4yt"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "url": "https://mp4yt.com/contact-us/",
        "contactType": "customer support"
      }
    })} />

    <!-- Structured Data (JSON-LD) — WebSite with SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "mp4yt",
      "url": "https://mp4yt.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://mp4yt.com/?url={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Structured Data (JSON-LD) — BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbListItems
    })} />

  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <slot />


    <!-- GSAP + ScrollTrigger — deferred to avoid blocking first paint (~35KB gzip) -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js" defer is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js" defer is:inline></script>

    <script is:inline>
      (function() {
        // Skip SW registration for search engine renderers (Googlebot WRS rejects .register())
        if (/googlebot|google-inspectiontool|bingbot|yandex/i.test(navigator.userAgent)) return;
        if (!('serviceWorker' in navigator)) return;
        try {
          window.addEventListener('load', function() {
            try {
              navigator.serviceWorker.register('/sw.js')
                .catch(function() { /* silent — expected in some environments */ });
            } catch (e) { /* silent */ }
          });
        } catch (e) { /* silent */ }
      })();
    </script>
    <CookieBanner />
  </body>
</html>
