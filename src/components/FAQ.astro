---
// FAQ Component — Highly SEO-optimized reusable component.
// Automatically renders standard FAQs for the main page or custom ones if passed as props.

interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  faqs?: FAQItem[];
}

const defaultFaqs: FAQItem[] = [
  {
    q: "What is the best free YouTube video downloader?",
    a: "mp4yt is a free YouTube video downloader that works in your browser — no app or extension to install. It supports downloading videos as MP4 in resolutions from 360p to 4K Ultra HD, plus YouTube to MP3 conversion. There are no download limits, no account required, and no ads."
  },
  {
    q: "How do I download YouTube videos to MP4?",
    a: "To download a YouTube video as MP4: copy the video URL from YouTube, open mp4yt.com, paste the URL, and click Extract. Choose your preferred resolution (360p to 4K), then click Download. On iPhone, save the file via Safari's download manager. On Android, the MP4 saves directly to your Downloads folder."
  },
  {
    q: "Can I download Instagram Reels and TikTok videos?",
    a: "Yes. mp4yt is a universal video downloader that supports over 1000 platforms. You can download Instagram Reels and Stories, TikTok videos without watermark, Twitter/X clips, Facebook videos, Reddit posts with audio, Twitch clips, SoundCloud tracks, Vimeo videos, and much more. Just paste the URL and click Extract."
  },
  {
    q: "Is it safe to use an online video downloader?",
    a: "mp4yt is completely safe. It runs in your browser with no software to install, which means zero malware risk. We don't collect personal data, don't use tracking cookies, and never store downloaded files on our servers. The video is downloaded directly from the platform's own CDN to your device."
  },
  {
    q: "How do I convert YouTube to MP3?",
    a: "To convert a YouTube video to MP3, paste the YouTube URL into mp4yt and click Extract. When the results appear, select the Audio (MP3) option from the quality dropdown, then click Download. The MP3 file will save to your device — perfect for music, podcasts, lectures, and audiobooks."
  },
  {
    q: "Does this video downloader work without installing an app?",
    a: "Yes. mp4yt requires zero installation. It works entirely in your web browser — Chrome, Safari, Firefox, Edge, or any modern browser. There is no desktop software, browser extension, or mobile app to download. This makes it the fastest and safest way to download videos online."
  },
  {
    q: "What video quality and formats are available?",
    a: "mp4yt supports every resolution the original video offers: 360p, 480p, 720p HD, 1080p Full HD, 1440p 2K, and 2160p 4K Ultra HD. You can download as MP4 (video) or MP3 (audio only). The downloaded file matches the exact quality uploaded by the content creator — no compression or quality loss."
  }
];

const { faqs = defaultFaqs } = Astro.props;

// Generate FAQPage Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section id="faq" class="faq-band" aria-labelledby="faq-headline">
  <!-- Structured Data JSON-LD Schema for SEO Search Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="page-container faq-inner">
    <div class="faq-header">
      <span class="eyebrow">FAQ Section</span>
      <h2 id="faq-headline" class="display-lg faq-title">
        Frequently Asked Questions
      </h2>
      <p class="body-sm faq-desc">
        Got questions about downloading video and audio from YouTube or other platforms? Find all the answers you need about safety, legalities, and quality below.
      </p>
    </div>

    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>
            <span class="faq-question">{faq.q}</span>
            <svg class="faq-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </summary>
          <div class="faq-body">
            <p class="body-md">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-band {
    background-color: var(--color-canvas);
    padding: var(--sp-5xl) var(--sp-lg);
    border-top: var(--border);
  }

  .faq-inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: var(--sp-3xl);
    align-items: start;
  }

  .faq-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    position: sticky;
    top: 80px;
  }

  .faq-title {
    margin: 0;
    max-width: 300px;
    color: var(--color-ink);
  }

  .faq-desc {
    margin: 0;
    color: var(--color-mute);
    line-height: 1.6;
  }

  .faq-list {
    border-top: var(--border);
  }

  details.faq-item {
    border-bottom: var(--border);
  }

  details.faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    padding: var(--sp-lg) var(--sp-sm);
    font-family: var(--font-headline);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: all 0.1s ease;
    user-select: none;
  }

  details.faq-item summary::-webkit-details-marker { display: none; }
  details.faq-item summary::marker { display: none; }
  
  .faq-question {
    flex: 1;
    text-align: left;
  }

  details.faq-item summary:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    padding-left: var(--sp-md);
    padding-right: var(--sp-md);
  }

  details.faq-item summary:hover .faq-icon {
    color: var(--color-on-primary);
  }

  details.faq-item .faq-body {
    padding: 0 var(--sp-sm) var(--sp-lg) var(--sp-sm);
    color: var(--color-body);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    height: 0;
    overflow: hidden;
    transition: height 0.3s ease;
  }

  details.faq-item[open] .faq-body {
    height: auto;
  }

  details.faq-item .faq-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.3s ease;
  }

  details.faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  @media (max-width: 992px) {
    .faq-inner {
      grid-template-columns: 1fr;
      gap: var(--sp-xl);
    }

    .faq-header {
      position: static;
      max-width: 100%;
    }

    .faq-title {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .faq-band {
      padding: var(--sp-4xl) var(--sp-md);
    }
  }

  @media (max-width: 480px) {
    .faq-band {
      padding: var(--sp-3xl) var(--sp-sm);
    }

    details.faq-item summary {
      font-size: 14px;
      padding: var(--sp-md) var(--sp-xs);
    }

    details.faq-item .faq-body {
      font-size: 13px;
      line-height: 1.5;
      padding-bottom: var(--sp-md);
    }
  }
</style>
