---
// ReadingProgress — CSS-only reading progress bar using scroll-driven animation
// Falls back to hidden in unsupported browsers (progressive enhancement)
---

<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress-bar"></div>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101;
    height: 3px;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 100%;
    background-color: var(--color-primary);
    transform-origin: left;
    transform: scaleX(0);
    animation: reading-progress-fill linear forwards;
    animation-timeline: scroll();
  }

  @keyframes reading-progress-fill {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* Hide in browsers that don't support scroll-driven animations */
  @supports not (animation-timeline: scroll()) {
    .reading-progress {
      display: none;
    }
  }
</style>
