---
// Breadcrumbs — Visual breadcrumb trail matching brutalist design system
interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs-list" role="list">
    {items.map((item, i) => (
      <li class="breadcrumbs-item">
        {i < items.length - 1 ? (
          <>
            <a href={item.href} class="breadcrumbs-link">{item.name}</a>
            <span class="breadcrumbs-sep" aria-hidden="true">/</span>
          </>
        ) : (
          <span class="breadcrumbs-current" aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: var(--sp-sm) 0;
  }

  .breadcrumbs-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-xxs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs-item {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-xxs);
  }

  .breadcrumbs-link {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-mute);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.1s ease;
  }

  .breadcrumbs-link:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .breadcrumbs-sep {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    opacity: 0.5;
    user-select: none;
  }

  .breadcrumbs-current {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
