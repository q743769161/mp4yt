---
// ComparisonTable — Reusable format comparison table with brutalist styling
// Accepts headers and rows as props for flexible content

interface Props {
  caption?: string;
  headers: string[];
  rows: string[][];
}

const { caption, headers, rows } = Astro.props;
---

<div class="comparison-table-wrap">
  <table class="comparison-table" role="table">
    {caption && <caption class="comparison-caption">{caption}</caption>}
    <thead>
      <tr>
        {headers.map(h => (
          <th scope="col">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          {row.map((cell, i) => (
            i === 0
              ? <th scope="row">{cell}</th>
              : <td>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .comparison-table-wrap {
    overflow-x: auto;
    border: var(--border);
    margin: var(--sp-md) 0;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .comparison-caption {
    font-family: var(--font-headline);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: left;
    padding: var(--sp-sm) var(--sp-md);
    color: var(--color-ink);
    border-bottom: var(--border);
  }

  .comparison-table th[scope="col"] {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    text-align: left;
    padding: 10px 14px;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .comparison-table th[scope="row"] {
    text-align: left;
    padding: 10px 14px;
    font-weight: 700;
    color: var(--color-ink);
    border-top: var(--border-thin);
  }

  .comparison-table td {
    padding: 10px 14px;
    border-top: var(--border-thin);
    color: var(--color-body);
  }

  .comparison-table tr:hover td,
  .comparison-table tr:hover th[scope="row"] {
    background-color: var(--color-canvas-soft-2);
  }

  @media (max-width: 480px) {
    .comparison-table {
      font-size: 11px;
    }
    .comparison-table th,
    .comparison-table td {
      padding: 8px 10px;
    }
  }
</style>
